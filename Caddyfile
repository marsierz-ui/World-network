{
	admin off
	# TLS ends at the platform's proxy; this only ever speaks plain HTTP behind it.
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Vite fingerprints everything under /assets, so it can be cached for good.
	# The shell and the service worker must be revalidated or a deploy never lands.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	# Deep links (/visits, /card) are routes inside the app, not files.
	try_files {path} /index.html
	file_server
}
