# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed vars to the client.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# Server-side only (Edge Functions / supabase config) — do NOT prefix with VITE_.
# GOOGLE_SECRET is what supabase/config.toml reads for the Auth provider.
# GOOGLE_CLIENT_SECRET is the same value under the name the google-token and
# google-sync-cron Edge Functions read - set that one with `supabase secrets
# set`, not from this file. CRON_SECRET (also `supabase secrets set`, plus the
# matching GitHub secret SYNC_CRON_SECRET) authorizes calls to google-sync-cron.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Edge Function only. Origins the google-token function will answer, comma
# separated. Defaults to the deployed site plus localhost:5173; set it with
# `supabase secrets set` when the app is deployed anywhere else.
ALLOWED_ORIGINS=
